DOMAIN=evidence.example.com          # or localhost for a local trial
ANTHROPIC_API_KEY=
LLAMA_CLOUD_API_KEY=                 # optional: screenshots and scanned PDFs need it
EVIDENCE_MODEL=claude-sonnet-5-5
EVIDENCE_BUDGET_USD=10               # per user per month; jobs that would exceed it are refused
EVIDENCE_MAX_FILES=300
EVIDENCE_MAX_ZIP_MB=500
EVIDENCE_DEMO_USER=reviewer          # this login can look at its cases but not upload, delete or review
EVIDENCE_LLM=anthropic               # 'scripted' = simulated LLM for smoke tests (banner shown)
